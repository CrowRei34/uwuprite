# Template file for 'uwuprite'

pkgname=uwuprite
version=1.3.18.3
revision=25

archs="x86_64"
restricted="Aseprite EULA does not allow redistribution"

depends="libX11 libXcursor libXi libXrandr virtual?libGL fontconfig
 hicolor-icon-theme desktop-file-utils"

short_desc="Aseprite pixel-art editor (precompiled build)"
maintainer="Orphaned <orphan@voidlinux.org>"
license="custom:Aseprite EULA"
homepage="https://github.com/CrowRei34/uwuprite"

distfiles="https://github.com/CrowRei34/uwuprite/releases/download/continuous/uwuprite-x86_64.tar.xz"
checksum=35cd11caf108cc0c79d6d3b9f04106d635015126d0022588028acdaecc87a871

do_install() {
	vbin bin/uwuprite
	vcopy bin/data usr/bin
	vlicense share/licenses/uwuprite/EULA.txt
	vinstall share/applications/uwuprite.desktop 644 usr/share/applications
	vinstall share/icons/hicolor/256x256/apps/uwuprite.png 644 usr/share/icons/hicolor/256x256/apps
}
