do_install() {
	vbin bin/uwuprite
	vcopy bin/data usr/bin
	vlicense share/licenses/uwuprite/EULA.txt
	vinstall share/applications/uwuprite.desktop 644 usr/share/applications
	vinstall share/icons/hicolor/256x256/apps/uwuprite.png 644 usr/share/icons/hicolor/256x256/apps
}
