# Template file for 'uwuprite'

pkgname=uwuprite
version=1.3.18.2
revision=1

archs="x86_64"
restricted="Aseprite EULA does not allow redistribution"

hostmakedepends="clang cmake ninja unzip pkg-config"
makedepends="libX11-devel libXcursor-devel libXi-devel libXrandr-devel
 mesa-libGL-devel fontconfig-devel"
depends="libX11 libXcursor libXi libXrandr libGL fontconfig
 hicolor-icon-theme desktop-file-utils"

short_desc="Aseprite pixel-art editor compiled from source"
maintainer="Orphaned <orphan@voidlinux.org>"
license="custom:Aseprite EULA"
homepage="https://github.com/aseprite/aseprite"

distfiles="https://github.com/aseprite/aseprite/releases/download/v${version}/Aseprite-v${version}-Source.zip
 https://github.com/aseprite/skia/releases/download/m124-08a5439a6b/Skia-Linux-Release-x64.zip"
checksum="5729921c1b22f5ad0577a558c8ebf3f3d00a088d82972c45905954eda9c68ab1
 a327e89b244f24cecaa34eb37544bae00d447b96c583d26ed29d6a3ad2e8a8b8"
skip_extraction="Skia-Linux-Release-x64.zip"

do_configure() {
	vsrccopy Skia-Linux-Release-x64.zip .
	mkdir -p skia
	unzip -q Skia-Linux-Release-x64.zip -d skia

	export CC=clang
	export CXX=clang++
	cmake -S . -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_CXX_FLAGS:STRING=-stdlib=libstdc++ \
		-DCMAKE_EXE_LINKER_FLAGS:STRING=-stdlib=libstdc++ \
		-DLAF_BACKEND=skia \
		-DSKIA_DIR="${wrksrc}/skia" \
		-DSKIA_LIBRARY_DIR="${wrksrc}/skia/out/Release-x64" \
		-DSKIA_LIBRARY="${wrksrc}/skia/out/Release-x64/libskia.a"
}

do_build() {
	cmake --build build --target aseprite --parallel ${XBPS_MAKEJOBS}
}

do_install() {
	vbin build/bin/aseprite
	vlicense EULA.txt
	vinstall src/desktop/linux/aseprite.desktop 644 usr/share/applications
	vinstall data/icons/ase256.png 644 usr/share/icons/hicolor/256x256/apps aseprite.png
}
